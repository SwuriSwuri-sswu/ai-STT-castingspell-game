  tutorialPanel: {fileID: 166590490}
  tutorialText: {fileID: 1533873014}
  tutorialContent: "<b>\uD134\uC81C \uC804\uD22C!</b> \uB098\uC758 \uD134\uB9C8\uB2E4
    <b>\uC8FC\uBB38\uC744 \uD55C \uBC88</b> \uC678\uCE60 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB9C8\uC655\uC740
    \uCCB4\uB825\uC774 \uC904 \uB54C\uB9C8\uB2E4 <b>\uC18D\uC131\uC774 \uBC14\uB01D\uB2C8\uB2E4.</b>
    \uC704\uCABD\uC758 '\uC57D\uC810'\uC744 \uB178\uB9AC\uC138\uC694.\n\uC0C1\uC131
    \uB9C8\uBC95\uC73C\uB85C \uB9DE\uD788\uBA74 \uCCB4\uB825\uC744 \uD68C\uBCF5\uD558\uACE0,
    \uB9C8\uC655\uC774 \uBAA8\uC73C\uB294 \uB9C8\uBC95\uB3C4 \uB04A\uC5B4\uB0BC \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\n\uD558\uC218\uC778\uC774 \uB098\uD0C0\uB098\uBA74
    \uBA3C\uC800 \uCC98\uCE58\uD558\uC138\uC694!\n<b>30\uD134</b> \uC548\uC5D0 \uB9C8\uC655\uC744
    \uC4F0\uB7EC\uB728\uB824\uC57C \uD569\uB2C8\uB2E4."
  tutorialTime: 7
  entranceNotice: "\uCE68\uBB35\uC758 \uB9C8\uC655\uC774 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0C8\uB2E4!"
  playerTurnTime: 10
