MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1881330307}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c808a62404a2bd40b578c0ec2706acf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingSceneController
  victoryText: {fileID: 1872141737}
  victoryTitle: VICTORY!
  victoryColor: {r: 1, g: 0.84, b: 0, a: 1}
  resultText: {fileID: 1288638208}
  typeResult: 1
  typeInterval: 0.035
  typeLinePause: 0.25
  victoryHold: 4
  titleStartScale: 1.6
  storyText: {fileID: 1105966237}
  story: 'The Demon Lord of Silence has fallen.


    His spell breaks, and sound
    returns to the castle -

    the wind through the towers, the crackle of the
    torches,

    and the voices of the people who had been silenced.


    Your
    words became magic,

    and your magic gave the world its voice again.


    Thank
    you, brave chanter.'
  paragraphInterval: 1.8
  storyHold: 3
  creditsText: {fileID: 921053275}
  credits: '<size=130%>[Game Title]</size>

    <size=80%>a voice-casting magic adventure</size>





    <size=110%>Team
    SwuriSwuri</size>



